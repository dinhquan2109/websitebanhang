# Shop Dinhquan — bắt buộc để đăng nhập/đăng ký (copy file này thành .env.local)
# Lấy URL + anon key: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Nếu bật "Confirm email" trong Auth, phải xác nhận email trước khi login được
# Hoặc (tương đương, cho local):
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# URL công khai của site (Vercel: https://ten-du-an.vercel.app) — dùng cho email đặt lại mật khẩu
NEXT_PUBLIC_SITE_URL=http://localhost:3000
